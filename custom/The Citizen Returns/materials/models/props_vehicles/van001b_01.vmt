
"VertexLitGeneric"
{
	// Original shader: VertexLitTexture
	"$basetexture" "Models/props_vehicles/van001b_01"
	"$surfaceprop" "solidmetal"
	"$envmap" "env_cubemap"
	//"$basealphaenvmapmask" 1
	"$envmapmask" "Models/props_vehicles/van001_envmapmask"
	"$envmaptint" "[.25 .25 .25]"

	
	$detail detail\metal_detail_01
	$detailtexturetransform "center .5 .5 scale 8 4 rotate 0 translate 0 0" 
	$detailblendfactor .85
	$detailblendmode 0

 	"vertexlitgeneric_HDR_dx9"
 	{
  		"$envmaptint" "[.25 .25 .25]"
 	}


	"vertexlitgeneric_DX9"
 	{
  		"$envmaptint" "[.25 .25 .25]"
 	}
}
