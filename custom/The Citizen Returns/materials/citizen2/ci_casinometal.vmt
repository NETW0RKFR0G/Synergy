"LightmappedGeneric"

{ "$basetexture" "citizen2/ci_casinometal" 
  "$surfaceprop" "metal"
  "$bumpmap" "citizen2/ci_casinometal_normal"
  "$envmap" "env_cubemap"  
   "$normalmapalphaenvmapmask" 1


	$detail detail\metal_detail_01
  	$detailscale 2.5
  	$detailblendfactor 0.95
  	$detailblendmode 0

} 