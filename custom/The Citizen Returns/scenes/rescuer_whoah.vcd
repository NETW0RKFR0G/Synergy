// Choreo version 1
actor "rescuer_1"
{
  channel "WAV"
  {
    event speak "1"
    {
      time 0.053333 1.678684
      param "npc_rescuer_whoa"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "Look at"
  {
    event lookat "1"
    {
      time 0.020000 1.666667
      param "lookat_camera_player"
    }
  }
  channel "Face"
  {
    event face "1"
    {
      time 0.020000 1.653333
      param "lookat_camera_player"
    }
  }
  channel "Gesture"
  {
    event gesture "1"
    {
      time 0.000000 2.233334
      param "G_noway_big"
      absolutetags playback_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      absolutetags shifted_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      sequenceduration 2.233333
    }
  }
  channel "Expression"
  {
    event flexanimation "1"
    {
      time 0.026667 2.220000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.3120 0.2114
          0.3480 1.0000
        }
        {
          0.3120 0.5000
          0.3480 0.5000
        }
        "inner_raiser" combo 
        {
          0.3120 0.2114
          0.3480 1.0000
        }
        {
          0.3120 0.5000
          0.3480 0.5000
        }
        "outer_raiser" combo 
        {
          0.3120 0.2114
          0.3480 1.0000
        }
        {
          0.3120 0.5000
          0.3480 0.5000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
