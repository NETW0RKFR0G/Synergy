    }
    event speak "getdownthere"
    {
      time 2.506667 3.568527
      param "npc_larry_canyon_getdownthere"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "facial expressions"
  {
    event flexanimation "flex"
    {
      time 0.073334 2.653334
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.0860 1.0000
          0.3160 0.0003
        }
        {
          0.0860 0.5000
          0.3160 0.5000
