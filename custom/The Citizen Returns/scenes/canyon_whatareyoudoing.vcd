        {
          0.0860 0.3100
        }
        {
          0.0860 0.5000
        }
        "outer_raiser" combo 
        {
          0.3160 1.0000
        }
        {
          0.3160 0.5000
        }
        "lowerer" combo 
        {
          0.0860 1.0000
          0.3160 0.0003
        }
        {
          0.0860 0.5000
          0.3160 0.5000
        }
        "corner_depressor" combo 
        {
          0.0860 0.8000
          0.3160 0.0002
        }
        {
          0.0860 0.5000
          0.3160 0.5000
        }
        "part" combo 
        {
          0.0860 1.0000
          0.3160 0.0003
        }
        {
          0.0860 0.5000
          0.3160 0.5000
        }
        "head_updown" range 15.0 -15.0 
        {
          0.0860 0.2900
          0.3160 0.4999
        }
      }
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 2.333334 3.966667
      param "g_point"
