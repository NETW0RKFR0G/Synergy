      {
        "apex" 0.250000
        "accent" 0.416667
        "loop" 0.562500
        "end" 0.729167
      }
      absolutetags shifted_time
      {
        "apex" 0.147059
        "accent" 0.367647
        "loop" 0.588235
        "end" 0.602941
      }
      sequenceduration 2.300000
    }
    event gesture "gest0"
    {
      time 0.046667 2.280000
      param "G_noway_big"
      absolutetags playback_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      absolutetags shifted_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
