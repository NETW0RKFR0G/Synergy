      time 0.060000 6.053333
      param "!player"
    }
  }
}

scalesettings
{
  "SceneRampTool" "100"
  "GestureTool" "100"
  "ExpressionTool" "100"
  "RampTool" "100"
  "CChoreoView" "100"
}
fps 60
snap off
ignorePhonemes off
