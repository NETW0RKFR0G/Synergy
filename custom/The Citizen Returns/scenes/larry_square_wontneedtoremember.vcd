// Choreo version 1
actor "larry"
{
  channel "WAV"
  {
    event speak "wav"
    {
      time 0.133333 2.565623
      param "npc_larry_square_wontneedtoremember"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 0.473333 2.106666
      param "hg_headshake"
      absolutetags playback_time
      {
        "apex" 0.208333
        "loop" 0.270833
        "extreme" 0.416667
        "end" 0.625000
      }
      absolutetags shifted_time
      {
        "apex" 0.208333
        "loop" 0.270833
        "extreme" 0.416667
        "end" 0.625000
      }
    }
  }
  channel "expression"
  {
    event flexanimation "flex1"
    {
      time 0.060000 2.540000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "half_closed" 
        {
          0.1180 0.0000
        }
        "lowerer" combo 
        {
          0.1180 1.0000
        }
        {
          0.1180 0.5000
        }
        "cheek_raiser" combo 
        {
          0.1180 1.0000
        }
        {
          0.1180 0.5000
        }
        "wrinkler" 
        {
          0.1180 1.0000
        }
        "dilator" 
        {
          0.1180 0.9400
        }
        "upper_raiser" combo 
        {
          0.1180 1.0000
        }
        {
          0.1180 0.5000
        }
        "part" combo 
        {
          0.1180 1.0000
        }
        {
          0.1180 0.5000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "ExpressionTool" "100"
  "RampTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
