      param "npc_larry_a1_dontgettooexcited"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "Lookingat"
  {
  }
  channel "Face"
  {
    event flexanimation "flex1"
    {
      time 0.095238 1.964285
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_tightener" combo 
        {
          0.1840 1.0000
        }
        {
          0.1840 0.5000
        }
        "lowerer" combo 
        {
          0.1840 1.0000
        }
        {
          0.1840 0.5000
        }
        "cheek_raiser" combo 
        {
          0.1840 0.7800
        }
        {
          0.1840 0.5000
        }
        "bite" 
        {
          0.1840 0.5400
        }
      }
    }
  }
  channel "Gestures"
  {
    event gesture "gest1"
    {
      time 0.047857 2.000000
      param "hg_headshake"
      absolutetags playback_time
      {
        "accent" 0.231838
        "apex" 0.244613
        "loop" 0.454281
        "extreme" 0.511396
        "end" 0.524171
      }
