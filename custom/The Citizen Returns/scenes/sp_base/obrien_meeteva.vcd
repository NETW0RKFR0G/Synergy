// Choreo version 1
actor "obrien"
{
  channel "wav"
  {
    event speak "obrien_meeteva"
    {
      time 0.106667 4.215601
      param "npc_obrien_meeteva"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "facetowards"
  {
    event face "faceboat"
    {
      time 0.026666 4.320000
      param "boat"
    }
  }
  channel "lookat"
  {
    event lookat "atboat"
    {
      time 0.020000 3.126667
      param "boat"
    }
    event lookat "atplayer"
    {
      time 3.200000 5.066667
      param "!player"
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 0.046667 2.080000
      param "g_present"
      absolutetags playback_time
      {
        "apex" 0.249054
        "accent" 0.614334
        "loop" 0.664145
        "end" 0.830181
      }
      absolutetags shifted_time
      {
        "apex" 0.192308
        "accent" 0.474359
        "loop" 0.512821
        "end" 0.641026
      }
      sequenceduration 2.633333
    }
    event gesture "gest2"
    {
      time 2.053333 3.753333
      param "G_shrug"
      absolutetags playback_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "end" 0.440000
      }
      absolutetags shifted_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "end" 0.440000
      }
      sequenceduration 1.700000
    }
    event gesture "gest3"
    {
      time 3.026666 4.993333
      param "g_fist_swing_across"
      absolutetags playback_time
      {
        "apex" 0.137931
        "accent" 0.258621
        "loop" 0.396552
        "end" 0.517241
      }
      absolutetags shifted_time
      {
        "apex" 0.176471
        "accent" 0.250000
        "loop" 0.441176
        "end" 0.588235
      }
      sequenceduration 2.300000
    }
  }
  channel "faceanimations"
  {
    event flexanimation "flex1"
    {
      time 3.193334 4.733334
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_tightener" combo 
        {
          0.1660 1.0000
        }
        {
          0.1660 0.5000
        }
        "tightener" 
        {
          0.1660 0.8000
        }
        "jaw_clencher" 
        {
          0.1660 1.0000
        }
        "smile" 
        {
          0.1660 0.4100
        }
        "head_tilt" range 15.0 -15.0 
        {
          0.1660 0.2000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
