// Choreo version 1
actor "sarah"
{
  channel "wav"
  {
    event speak "npc_anne_waterproof"
    {
      time 0.093334 1.764944
      param "npc_sarah_waterproof"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 0.033333 2.233333
      param "prop_battery"
    }
  }
  channel "gest"
  {
    event gesture "gest1"
    {
      time 0.240000 1.873333
      param "broadsweepdown"
      absolutetags playback_time
      {
        "apex" 0.333333
        "accent" 0.500000
        "extreme" 0.532500
        "end" 0.542500
        "loop" 0.552500
      }
      absolutetags shifted_time
      {
        "apex" 0.310345
        "accent" 0.500000
        "extreme" 0.541667
        "end" 0.655172
        "loop" 0.586207
      }
      sequenceduration 1.966667
    }
  }
  channel "flex"
  {
    event flexanimation "flex"
    {
      time 0.113334 2.166667
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "inner_raiser" combo 
        {
          0.1860 1.0000
        }
        {
          0.1860 0.5000
        }
        "corner_depressor" combo 
        {
          0.1860 0.4800
        }
        {
          0.1860 0.5000
        }
        "part" combo 
        {
          0.1860 1.0000
        }
        {
          0.1860 0.5000
        }
        "head_tilt" range 15.0 -15.0 
        {
          0.1860 0.0000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
