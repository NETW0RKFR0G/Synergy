// Choreo version 1
actor "obrien"
{
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 1.473333 2.766667
      param "!player"
    }
    event lookat "battery"
    {
      time 0.026667 1.426667
      param "battery"
    }
  }
  channel "facetowards"
  {
    event face "battery"
    {
      time 0.020000 1.413334
      param "battery"
    }
    event face "playah"
    {
      time 1.453333 2.893333
      param "!player"
    }
  }
  channel "gesture"
  {
    event gesture "shrug"
    {
      time 1.420000 3.120000
      param "hg_headshake"
      absolutetags playback_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "extreme" 0.416667
        "end" 0.440000
      }
      absolutetags shifted_time
      {
        "apex" 0.208333
        "accent" 0.240000
        "loop" 0.270833
        "extreme" 0.416667
        "end" 0.625000
      }
      sequenceduration 1.633333
    }
  }
  channel "flexanim"
  {
    event flexanimation "flex1"
    {
      time 0.080000 1.413334
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.1160 1.0000
        }
        {
          0.1160 0.5000
        }
        "lid_tightener" combo 
        {
          0.1160 1.0000
        }
        {
          0.1160 0.5000
        }
        "puckerer" combo 
        {
          0.1160 0.5300
        }
        {
          0.1160 0.5000
        }
        "head_forwardback" range 0.2 -0.2 
        {
          0.1160 0.0000
        }
      }
    }
    event flexanimation "flex2"
    {
      time 1.546666 3.053333
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "bite" 
        {
          0.1280 0.5600
        }
        "jaw_clencher" 
        {
          0.1280 1.0000
        }
        "eyes_updown" range 30.0 -30.0 
        {
          0.1280 1.0000
        }
        "eyes_rightleft" range 30.0 -30.0 
        {
          0.1280 0.4600
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "SceneRampTool" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
}
fps 60
snap off
ignorePhonemes off
