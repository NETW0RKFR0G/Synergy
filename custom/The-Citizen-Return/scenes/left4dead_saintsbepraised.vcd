      param "!player"
    }
    event lookat "lookatplayer"
    {
      time 0.100000 5.108335
      param "!player"
    }
  }
  channel "wav"
  {
    event speak "left4dead_saintsbepraised"
    {
      time 0.000000 5.095646
      param "npc_left4dead_saintsbepraised"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "animations"
  {
    event flexanimation "headanimation"
    {
