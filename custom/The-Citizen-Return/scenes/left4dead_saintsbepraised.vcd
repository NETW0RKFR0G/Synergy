    {
      time 3.012500 4.195833
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.1902 0.5900
        }
        {
          0.1902 0.5000
        }
        "outer_raiser" combo 
        {
          0.1902 1.0000
        }
        {
          0.1902 0.5000
        }
        "dilator" 
        {
          0.1902 0.5700
        }
        "puckerer" combo 
        {
          0.1902 0.5000
        }
        {
          0.1902 0.5000
        }
        "funneler" combo 
        {
          0.1902 1.0000
        }
        {
          0.1902 0.5000
        }
        "lower_lip" 
        {
          0.1902 0.8600
        }
        "head_forwardback" range 0.2 -0.2 
        {
          0.1902 0.3100
        }
      }
    }
  }
}

