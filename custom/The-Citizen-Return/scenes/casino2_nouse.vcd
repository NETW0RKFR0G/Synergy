// Choreo version 1
actor "stranded"
{
  channel "wav"
  {
    event speak "wav"
    {
      time 0.073334 3.856917
      param "npc_casino2_nouse"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "lookat"
  {
    event lookat "at player"
    {
      time 3.993334 5.019999
      param "!player"
    }
    event lookat "at player 0"
    {
      time 0.046667 1.613333
      param "!player"
    }
  }
  channel "face expression"
  {
    event flexanimation "flex1"
    {
      time 2.666666 3.973333
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_tightener" combo 
        {
          0.1740 0.5400
        }
        {
          0.1740 0.5000
        }
        "inner_raiser" combo 
        {
          0.1740 1.0000
        }
        {
          0.1740 0.5000
        }
        "part" combo 
        {
          0.1740 0.4500
        }
        {
          0.1740 0.5000
        }
        "bite" 
        {
          0.1740 0.3000
        }
        "jaw_drop" 
        {
          0.1740 0.6800
        }
        "head_tilt" range 15.0 -15.0 
        {
          0.1740 0.6700
        }
        "eyes_rightleft" range 30.0 -30.0 
        {
          0.1740 -0.0000
        }
      }
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 0.040000 1.673333
      param "hg_headshake"
      absolutetags playback_time
      {
        "apex" 0.208333
        "loop" 0.270833
        "extreme" 0.416667
        "end" 0.625000
      }
      absolutetags shifted_time
      {
        "apex" 0.208333
        "loop" 0.270833
        "extreme" 0.416667
        "end" 0.625000
      }
      sequenceduration 1.633333
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
