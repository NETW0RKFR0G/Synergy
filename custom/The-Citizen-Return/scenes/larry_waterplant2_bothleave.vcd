    {
      time 0.060000 0.960000
      param "rebel_sarah"
    }
    event lookat "atplayer"
    {
      time 1.120000 2.020000
      param "!player"
    }
  }
  channel "moveto"
  {
  }
  channel "face"
  {
    event face "facedoor"
    {
      time 0.026666 2.320000
      param "reactor_evacdoor2"
    }
  }
  channel "gesture"
  {
    event gesture "point"
    {
      time 0.353333 1.986666
      param "G_puncuate"
      absolutetags playback_time
      {
        "apex" 0.250000
        "accent" 0.416667
        "loop" 0.562500
        "end" 0.729167
      }
      absolutetags shifted_time
      {
        "apex" 0.250000
        "accent" 0.416667
        "loop" 0.562500
        "end" 0.729167
      }
      sequenceduration 1.633333
    }
  }
  channel "flex"
  {
  }
}

scalesettings
{
  "CChoreoView" "100"
  "ExpressionTool" "100"
  "RampTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
