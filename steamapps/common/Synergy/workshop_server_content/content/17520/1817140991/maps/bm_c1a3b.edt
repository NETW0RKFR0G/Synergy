bm_c1a3b
{
	console
	{
		sv_turbophysics "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
		edit {classname "item_grenade_mp5" values {classname "item_ammo_smg1_grenade"} }
		edit {classname "func_conveyor_bms" values {classname "func_conveyor" spawnflags "0"} }
//--
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
					ammo_smg1 "30"
				ResponseContext "weapon_mp5 weapon_glock"
			}
		}
		
		

//Tele vator managers
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapTransition "syn_spawn_manager,TeleportPlayers,syn_vator_teleport_loc_intro,0.1,-1"
			}
		}
		create {classname "info_teleport_destination" origin "1864 1184 -88"
			values
			{
				targetname "syn_vator_teleport_loc_intro"
				angles "0 270 0"
				parentname "c1a3b-c1a3c-elevator"
			}
		}
		delete {classname "info_player_start"}
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		create {classname "info_player_coop" origin "1860 995 -86" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 -90 0"} }
		create {classname "info_player_coop" origin "424 896 90" values {targetname "syn_spawnpoint_end" startdisabled "1" angles "0 90 0" parentname "c1a3b-c1a3c-elevator"} }

//Remove fail
		delete {targetname "c1a3b_loadsaved"}
//kill those who do though
		create {classname "trigger_hurt" origin "0 0 -1376"
			values
			{
				model "*88"
				spawnflags "1"
				damage "1000"
				damagetype "32"//fall
				nodmgforce "1"
			}
		}

//end vator
		edit {targetname "top_button" values {spawnflags "3105"} }//+Start Locked
		create {classname "trigger_coop" origin "688 688 94"
			values
			{
				model "*88"
				spawnflags "1"
				//targetname ""
				CountType "1"
				UseHUD "1"
				PlayerValue "66"
				OnPlayersIn "top_button,Unlock,,0,1"
				OnPlayersIn "!self,Kill,,1,1"
			}
		}
		create {classname "trigger_coop" origin "688 688 94"
			values
			{
				model "*88"
				spawnflags "1"
				targetname "syn_endtp"
				target "syn_vator_teleportcoop"
			}
		}
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "top_button,AddOutput,OnPressed syn_spawn_manager:TeleportPlayers:syn_vator_teleport_end:0:-1,0,-1"
				OnMapSpawn "top_button,AddOutput,OnPressed syn_endtp:TeleportPlayersNotTouching::0:-1,0,-1"
				OnMapSpawn "top_button,AddOutput,OnPressed syn_spawn_manager:SetCheckPoint:syn_spawnpoint_end:0:-1,0,-1"
			}
		}
		create {classname "info_teleport_destination" origin "424 896 90"//point_teleport (doesnt parent)
			values
			{
				targetname "syn_vator_teleport_end"
				angles "0 90 0"
				//target "!player"
				parentname "c1a3b-c1a3c-elevator"
			}
		}
		create {classname "info_target" origin "424 896 90" values {targetname "syn_vator_teleportcoop" parentname "c1a3b-c1a3c-elevator" angles "0 90 0"} }
		
		create {classname "func_button" origin "1864 1184 -128" values {model "*73"} }
		create {classname "trigger_teleport" origin "1864 1184 -232" values {edt_getbspmodelfor_classname "trigger_once" edt_getbspmodelfor_origin "1864 1184 -232" targetname "syn_stragglers" startdisabled "0" spawnflags "1" target "syn_tpspawnreturn"} }
		create {classname "trigger_teleport" origin "1864 1184 -662" values {edt_getbspmodelfor_classname "trigger_once" edt_getbspmodelfor_origin "1864 1184 -232" targetname "syn_stragglers" startdisabled "0" spawnflags "1" target "syn_tpspawnreturn"} }
		create {classname "trigger_teleport" origin "1864 1184 -1070" values {edt_getbspmodelfor_classname "trigger_once" edt_getbspmodelfor_origin "1864 1184 -232" targetname "syn_stragglers" startdisabled "0" spawnflags "1" target "syn_tpspawnreturn"} }
		create {classname "info_teleport_destination" origin "1870 1195 -85" values {targetname "syn_tpspawnreturn" angles "0 -90 0"} }

		create {classname "logic_relay" values {targetname "travis_func_tester"} }
	}
}