bm_c1a4a
{
	console
	{
		sv_turbophysics "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
		edit {classname "item_grenade_mp5" values {classname "item_ammo_smg1_grenade"} }
		edit {classname "func_conveyor_bms" values {classname "func_conveyor" spawnflags "0"} }
//--
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
					ammo_smg1 "30"
				weapon_shotgun "1"
					ammo_buckshot "12"
				ResponseContext "weapon_mp5 weapon_glock weapon_satchel"
			}
		}
		
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		create {classname "info_player_coop" origin "130 130 -1885" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 225 0"} }
		create {classname "info_player_coop" origin "1010 -1335 -2340" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 -40 0"} }
		create {classname "syn_transition_wall" origin "20 0 220" values {solid "6" angles "90 0 0" DisableShadows "1" startdisabled "1"} }
		edit {targetname "c1a4e_water_overlay" values {spawnflags "1"} }
		
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "syn_fogtrig1,AddOutput,OnStartTouch !activator:SetFogController:syn_fog_controllerunderwater:0:-1,0,-1"
				OnMapSpawn "syn_fogtrig2,AddOutput,OnStartTouch !activator:SetFogController:c1a4g_fog_controllerstart:0:-1,0,-1"
			}
		}
		
		edit {classname "trigger_multiple" origin "0 0 -2368" values {targetname "syn_fogtrig1"} }
		edit {classname "trigger_multiple" origin "0 0 -2344" values {targetname "syn_fogtrig2"} }
		edit {targetname "c1a4g_fog_controller"
			values
			{
				targetname "c1a4g_fog_controllerstart"
				fogenable "1"
				fogcolor2 "63 79 31"
				fogcolor "127 159 63"
				fogstart "-768"
				fogend "12288"
			}
		}
		create {classname "env_fog_controller"
			values
			{
				targetname "syn_fog_controllerunderwater"
				fogstart "1280"
				fogmaxdensity "1"
				fogend "2560"
				fogenable "0"
				fogdir "1 0 0"
				fogcolor2 "0 0 0"
				fogcolor "0 0 0"
				fogblend "0"
				farz "-1"
			}
		}
		
		create {classname "trigger_multiple" origin "1590 -1335 -2145"
			values
			{
				edt_getbspmodelfor_classname "trigger_multiple"
				edt_getbspmodelfor_origin "0 0 -2256"
				spawnflags "1"
				wait "3"
				OnTrigger "syn_spawn_manager,SetCheckPoint,syn_spawnpoint_01,0,1"
				OnTrigger "!activator,SetFogController,c1a4g_fog_controllerstart,0,-1"
			}
		}
		
		create {classname "syn_transition_wall" origin "3455 5 -2550" values {targetname "syn_antirush_wall" angles "0 90 0" solid "6" DisableShadows "1"} }
		create {classname "trigger_coop" origin "3435 335 -2425"
			values
			{
				edt_getbspmodelfor_classname "trigger_multiple"
				edt_getbspmodelfor_origin "0 0 -2256"
				startdisabled "0"
				spawnflags "1"
				usehud "1"
				playervalue "66"
				counttype "1"
				OnPlayersIn "syn_antirush_wall,kill,,0,-1"
				OnPlayersIn "!self,kill,,0,-1"
			}
		}
	}
}