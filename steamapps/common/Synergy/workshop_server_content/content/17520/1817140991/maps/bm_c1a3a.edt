bm_c1a3a
{
	console
	{
		sv_turbophysics "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
//--

		edit {classname "env_message" values {spawnflags "2"} }
		edit {targetname "new_game_spawn" values {targetname "syn_disableIO_new_game_spawn"} }
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
				ResponseContext "weapon_glock"
			}
		}
		
		delete {classname "info_player_start"}
		create {classname "info_player_coop" origin "-520 990 -92" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 0 0"} }
		create {classname "info_player_coop" origin "-1610 -90 -90" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 180 0"} }
		create {classname "info_player_coop" origin "-2860 -620 -50" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 0 0"} }
		create {classname "info_player_coop" origin "768 -2400 -309" values {targetname "syn_spawnpoint_elev" startdisabled "1" angles "0 90 0" parentname "AToBElev"} }

//Don't close intro vator doors
		delete {classname "trigger_once" origin "-264 992 -64"}

//New Weapons
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_shotgun"
				StartDisabled "1"
				weapon_shotgun "1"
					ammo_buckshot "6"
			}
		}
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_mp5"
				StartDisabled "1"
				ResponseContext "weapon_mp5"
					ammo_smg1 "30"
			}
		}
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "weapon_mp5k,AddOutput,OnCacheInteraction syn_equipment_mp5:Enable::0:-1,0,-1"//OnPlayerTouch
				OnMapSpawn "weapon_mp5k,AddOutput,OnCacheInteraction syn_equipment_mp5:EquipAllPlayers::0.1:-1,0,-1"//OnPlayerTouch
				OnMapSpawn "weapon_shotgun,AddOutput,OnCacheInteraction syn_equipment_shotgun:Enable::0:-1,0,-1"//OnPlayerTouch
				OnMapSpawn "weapon_shotgun,AddOutput,OnCacheInteraction syn_equipment_shotgun:EquipAllPlayers::0.1:-1,0,-1"//OnPlayerTouch
				OnMapSpawn "ventact,AddOutput,OnUser4 ventremoval:kill::0:-1,0,-1"
				OnMapSpawn "ventact,FireUser4,,0.1,-1"
				OnMapSpawn "ventact,AddOutput,OnTrigger LCS_blastpitaccess_main:Resume::10:-1,0,-1"
				OnMapSpawn "ventremoval,Trigger,,0.2,1"
			}
		}
		create {classname "logic_relay"
			values
			{
				targetname "ventremoval"
				OnTrigger "ventmod,kill,,0,-1"
			}
		}
		create {classname "env_global"
			values
			{
				//initialstate "0"
				targetname "syn_global_shotgun"
				globalstate "syn_shotgun_found"
			}
		}
		
		edit {classname "trigger_once" origin "-2016 -528 -74" values {targetname "syn_trig1"} }

//end vator
		edit {targetname "eb" values {targetname "syn_disableIO_eb" spawnflags "3105"} }
		create {classname "trigger_coop" origin "770 -2400 -231.5"
			values
			{
				edt_mins "-110 -110 -90"
				edt_maxs "120 100 90"
				spawnflags "1"
				targetname "syn_endelev"
				CountType "1"
				UseHUD "1"
				PlayerValue "66"
				OnStartTouch "syn_spawn_manager,SetCheckPoint,syn_spawnpoint_elev,0,1"
				OnPlayersIn "syn_disableIO_eb,Unlock,,0,1"
				OnPlayersIn "syn_disableIO_eb,AddOutput,targetname eb,0.1,-1"
				OnPlayersIn "!self,Disable,,1,1"
			}
		}
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "syn_disableIO_eb,AddOutput,OnPressed syn_spawn_manager:TeleportPlayers:syn_vator_teleport_loc_end:0:-1,0,-1"
				OnMapSpawn "syn_trig1,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01:0:1,0,-1"
			}
		}
		create {classname "info_teleport_destination" origin "768 -2400 -309"
			values
			{
				targetname "syn_vator_teleport_loc_end"
				angles "0 90 0"
				parentname "AToBElev"
			}
		}
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }

//==return from 3c==

		create {classname "env_global" values {targetname "syn_gloset" globalstate "syn_transition"} }
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				globalstate "syn_transition"
				OnMapSpawn "syn_stragglers,Enable,,0,-1"
				OnMapSpawn "syn_spawn_manager,SetCheckPoint,syn_spawnpoint_02,0,1"
				OnMapSpawn "syn_spawnpoint_00,kill,,0,-1"
				OnMapSpawn "syn_trigsci,AddOutput,OnTrigger syn_stragglers:kill::0:1,0,-1"
			}
		}
//Block Backtracking
		create {classname "prop_dynamic" origin "-3319.99 -1072 16"
			values
			{
				model "models/synergy/tools/syn_transition.mdl"
				angles "0 90 0"
				solid "6"
				DisableShadows "1"
			}
		}
		
		create {classname "trigger_teleport" origin "-478 993 -75" values {edt_getbspmodelfor_classname "trigger_once" edt_getbspmodelfor_origin "-470.48 611.13 -76" targetname "syn_stragglers" startdisabled "1" spawnflags "1" target "syn_tpspawnreturn"} }
		create {classname "info_teleport_destination" origin "-2860 -620 -50" values {targetname "syn_tpspawnreturn" angles "0 0 0"} }
		
		edit {classname "trigger_once" origin "-752 480 -64" values {targetname "syn_trigsci"} }
		//create {classname "filter_activator_class" values {targetname "noplydmg" filterclass "player" Negated "1"} }
		//edit {targetname "SCI02_SiloDoorsController" values {damagefilter "noplydmg"} }

//dont close security door
		delete {classname "trigger_once" origin "-470.48 611.13 -76"}
		create {classname "trigger_once" origin "-470.48 611.13 -76"
			values
			{
				edt_getbspmodelfor_classname "trigger_once"
				edt_getbspmodelfor_origin "-470.48 611.13 -76"
				spawnflags "1"
				//OnStartTouch "sec_door_02,Close,,0.1,1"
				//OnStartTouch "sec_door_02,Lock,,0,1"
				OnTrigger "sec_door_02,Unlock,,1,-1"
				OnTrigger "LCS_blastpitaccess_main,Start,,0,1"
				OnTrigger "LCS_blastpitaccess_main,Resume,,10,1"
				OnTrigger "song,PlaySound,,0,-1"
			}
		}
//VentMod change origin
		edit {classname "trigger_once" origin "-470.48 511.34 -76" values {targetname "ventact"} }
		create {classname "trigger_once" origin "-470.48 511.34 -76"
			values
			{
				targetname "ventmod"
				edt_getbspmodelfor_classname "trigger_once"
				edt_getbspmodelfor_origin "-470.48 511.34 -76"
				spawnflags "1"
				//OnStartTouch "sec_door_02,Close,,0.1,1"
				//OnStartTouch "sec_door_02,Lock,,0,1"
				OnTrigger "sec_door_02,Unlock,,1,-1"
				OnTrigger "LCS_blastpitaccess_main,Start,,0,1"
				OnTrigger "LCS_blastpitaccess_main,Resume,,10,1"
				OnTrigger "song,PlaySound,,0,-1"
			}
		}

		create {classname "logic_relay" values {targetname "travis_func_tester"} }
	}
}