bm_c2a4c
{
	console
	{
		sv_turbophysics "0"
		mp_player_death_items "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
		edit {classname "item_grenade_mp5" values {classname "item_ammo_smg1_grenade"} }
		edit {classname "func_conveyor_bms" values {classname "func_conveyor" spawnflags "0"} }
		edit {classname "npc_gargantua" values {classname "npc_bmsgargantua"} }
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
					ammo_smg1 "30"
				weapon_shotgun "1"
					ammo_buckshot "6"
				ResponseContext "weapon_mp5 weapon_glock weapon_satchel"
			}
		}
		
		delete {targetname "new_game_spawn"}
		delete {targetname "weapons"}
		delete {targetname "suit"}
		delete {classname "info_player_start"}
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		create {classname "info_player_coop" origin "-1200 2190 530" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 -90 0"} }
		create {classname "info_player_coop" origin "-790 -955 165" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 90 0"} }
		create {classname "info_player_coop" origin "-835 -3145 -220" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 180 0"} }
		create {classname "syn_transition_wall" origin "-1693 1718 400" values {solid "6" targetname "syn_backtrack" angles "0 0 0"} }
		
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "syn_antirush_wall2,kill,,0,-1"
				OnMapSpawn "conveyor_carrier01_controller,AddOutput,OnPressed syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01:0:1,0,-1"
			}
		}
		
		delete {targetname "c2a4c_c2a4e_trig"}
		//Skip crashy map
		//edit {classname "trigger_multiple" origin "-1180 -3144 -188" values {classname "trigger_changelevel" map "bm_c2a4e" landmark "c2a4c_c2a4e_trans"} }
		edit {classname "trigger_multiple" origin "-1180 -3144 -188" values {classname "trigger_changelevel" map "bm_c2a4fedt" landmark "c2a4c_c2a4e_trans"} }
		create {classname "syn_transition_wall" origin "-1150 -3145 -400" values {solid "6" targetname "syn_antirush_wall"} }
		create {classname "trigger_coop" origin "-1068 -3148 -240"
			values
			{
				//edt_getbspmodelfor_classname "trigger_once"
				//edt_getbspmodelfor_origin "-832 -1984 -336"
				model "*94"
				startdisabled "0"
				spawnflags "1"
				usehud "1"
				counttype "1"
				playervalue "70"
				OnTrigger "syn_spawn_manager,SetCheckPoint,syn_spawnpoint_02,0,1"
				OnPlayersIn "syn_antirush_wall,kill,,0,1"
				OnPlayersIn "!self,Disable,,0.1,-1"
			}
		}
		//Make the pistons slightly easier
		edit {targetname "c2a4c_piston06_5" values {origin "-640 768 635"} }
		edit {targetname "c2a4c_piston06_4" values {origin "-640 768 635"} }
		edit {targetname "c2a4c_piston06_1" values {origin "-640 768 635"} }
		edit {targetname "c2a4c_piston05_5" values {origin "-752 768 635"} }
		edit {targetname "c2a4c_piston05_4" values {origin "-752 768 635"} }
		edit {targetname "c2a4c_piston05_1" values {origin "-752 768 635"} }
		edit {targetname "c2a4c_piston04_5" values {origin "-864 768 635"} }
		edit {targetname "c2a4c_piston04_4" values {origin "-864 768 635"} }
		edit {targetname "c2a4c_piston04_1" values {origin "-864 768 635"} }
		edit {targetname "c2a4c_piston03_5" values {origin "-1200 1136 635"} }
		edit {targetname "c2a4c_piston03_4" values {origin "-1200 1136 635"} }
		edit {targetname "c2a4c_piston03_1" values {origin "-1200 1136 635"} }
		edit {targetname "c2a4c_piston02_5" values {origin "-1200 1024 635"} }
		edit {targetname "c2a4c_piston02_4" values {origin "-1200 1024 635"} }
		edit {targetname "c2a4c_piston02_1" values {origin "-1200 1024 635"} }
		edit {targetname "c2a4c_piston01_5" values {origin "-1200 912 635"} }
		edit {targetname "c2a4c_piston01_4" values {origin "-1200 912 635"} }
		edit {targetname "c2a4c_piston01_1" values {origin "-1200 912 635"} }
	}
}