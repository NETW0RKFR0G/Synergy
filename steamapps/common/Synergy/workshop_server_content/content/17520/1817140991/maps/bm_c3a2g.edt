		create {classname "info_player_coop" origin "1548 1868 517" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 90 0"} }
		create {classname "info_player_coop" origin "752 240 532" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 90 0"} }
