					ammo_smg1 "30"
				weapon_shotgun "1"
					ammo_buckshot "12"
				ResponseContext "weapon_mp5 weapon_glock"
			}
		}
		
		delete {targetname "c1a4a_equipment"}
		delete {targetname "c1a4a_equipment_template"}
		delete {classname "info_player_start"}
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		create {classname "info_player_coop" origin "-2400 3464 1692" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 345 0"} }
		create {classname "info_player_coop" origin "-1380 4835 -820" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 0 0" parentname "c1a4a_tram_base"} }
		create {classname "info_player_coop" origin "-1280 -4610 -720" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 0 0"} }
		create {classname "info_player_coop" origin "-100 -2465 810" values {targetname "syn_spawnpoint_03" startdisabled "1" angles "0 90 0" parentname "c1a4a_elevator"} }
		create {classname "syn_transition_wall" origin "-2400 3570 1600" values {solid "6" targetname "syn_backtrack" angles "0 -90 0"} }
		create {classname "syn_transition_wall" origin "-2550 -5115 -820" values {solid "6" startdisabled "1"} }
		create {classname "syn_transition_wall" origin "-2550 -5115 -500" values {solid "6" startdisabled "1"} }
		
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "syn_trig1,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01:0:1,0,-1"
				OnMapSpawn "syn_trig2,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_02:0:1,0,-1"
				OnMapSpawn "c1a4a_elevator_button_02,AddOutput,OnPressed syn_cooptele_end:TeleportPlayersNotTouching::0:1,0,-1"
				OnMapSpawn "c1a4a_elev_stop_01,AddOutput,OnPass c1a4a_elevator_button_02:Lock::0.5:1,0,-1"
			}
		}
		
		edit {classname "trigger_once" origin "-1376 4824 -808" values {targetname "syn_trig1"} }
		edit {classname "trigger_multiple" origin "-384 -4040 -704" values {targetname "syn_trig2"} }
		
		edit {targetname "c1a4a_elevatordoor" values {classname "prop_dynamic" modelscale "1.4" solid "6"} }
		edit {targetname "c1a4a_elevator_button_02" values {spawnflags "3073"} }
		create {classname "trigger_coop" origin "-112 -2452 800"
			values
