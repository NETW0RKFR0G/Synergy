bm_c2a2b
{
	console
	{
		sv_turbophysics "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
		edit {classname "item_grenade_mp5" values {classname "item_ammo_smg1_grenade"} }
		edit {classname "func_conveyor_bms" values {classname "func_conveyor" spawnflags "0"} }
		edit {classname "npc_gargantua" values {classname "npc_bmsgargantua"} }
//--
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
					ammo_smg1 "30"
				weapon_shotgun "1"
					ammo_buckshot "12"
				ResponseContext "weapon_mp5 weapon_glock weapon_satchel"
			}
		}
		
		delete {classname "info_player_start"}
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		create {classname "info_player_coop" origin "-915 -3830 210" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 0 0" parentname "c2a2a_tram_a_base"} }
		create {classname "info_player_coop" origin "-2015 -930 220" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 180 0"} }
		create {classname "info_player_coop" origin "845 -1765 170" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 130 0"} }
		create {classname "info_player_coop" origin "1880 -400 170" values {targetname "syn_spawnpoint_03" startdisabled "1" angles "0 90 0"} }
		create {classname "info_player_coop" origin "2330 -5 1350" values {targetname "syn_spawnpoint_04" startdisabled "1" angles "0 180 0"} }
		create {classname "syn_transition_wall" origin "-688 -3888 -120" values {solid "6" targetname "syn_backtrack" angles "0 180 90" DisableShadows "1"} }
		
		delete {targetname "c2a2b_tram_a_armour"}
		delete {targetname "c2a2b_fog_trigger"}
		create {classname "trigger_multiple" origin "2704 0 1064" values {model "*161" spawnflags "1" OnTrigger "c2a2b_fog_enable,Trigger,,0,-1"} }
		
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "c2a2a_tram_a_prop,Enable,,1,-1"
				OnMapSpawn "c2a2a_tram_a_base,Stop,,0,-1"
				OnMapSpawn "syn_trig1,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01:0:1,0,-1"
				OnMapSpawn "syn_trig2,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_02:0:1,0,-1"
				OnMapSpawn "raise_button,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_04:0:1,0,-1"
			}
		}
		
		edit {classname "trigger_once" origin "-1328 0 264" values {targetname "syn_trig1"} }
		edit {classname "trigger_once" origin "344 -245.33 268" values {targetname "syn_trig2"} }
		
		delete {classname "trigger_once" origin "1645 -275 232"}
		create {classname "trigger_once" origin "1645 -275 232"
			values
			{
				//edt_getbspmodelfor_classname "trigger_once"
				//edt_getbspmodelfor_origin "1645 -275 232"
				model "*188"
				spawnflags "1"
				OnTrigger "c2a2b_silo_squad_01,Wake,,0,1"
				OnTrigger "c2a2b_silo_squad_02,Wake,,0,1"
				OnTrigger "c2a2b_silo_squad_03,Wake,,0,1"
