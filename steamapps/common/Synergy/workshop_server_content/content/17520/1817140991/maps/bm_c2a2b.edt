		create {classname "trigger_coop" origin "1865 -110 220"
			values
			{
				//edt_getbspmodelfor_targetname "c2a2b_attack_trigger"
				model "*145"
				angles "0 0 0"
				startdisabled "0"
				spawnflags "1"
				usehud "0"
				playervalue "100"
				counttype "1"
