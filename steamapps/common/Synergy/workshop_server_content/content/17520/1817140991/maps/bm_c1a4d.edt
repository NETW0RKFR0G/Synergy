bm_c1a4d
{
	console
	{
		sv_turbophysics "0"
	}
	entity
	{
//TEMP PLACEHOLDERS
		edit {classname "prop_flare" values {classname "prop_physics" model "models/props_junk/flare.mdl"} }
		edit {classname "item_weapon_crowbar" values {classname "weapon_crowbar"} }
		edit {classname "item_weapon_frag" values {classname "weapon_frag"} }
		edit {classname "item_weapon_357" values {classname "weapon_357"} }
		edit {classname "fog_volume" values {classname "func_smokevolume"} }
		edit {classname "item_weapon_shotgun" values {classname "weapon_shotgun"} }
		edit {classname "item_ammo_shotgun" values {classname "item_box_buckshot"} }
		edit {classname "item_grenade_mp5" values {classname "item_ammo_smg1_grenade"} }
		edit {classname "func_conveyor_bms" values {classname "func_conveyor" spawnflags "0"} }
//--
//Starting Equips
		create {classname "info_player_equip"
			values
			{
				targetname "syn_equipment_base"
				item_suit "1"
				weapon_crowbar "1"
					ammo_pistol "18"
				weapon_frag "1"
				weapon_357 "1"
					ammo_357 "6"
					ammo_smg1 "30"
				weapon_shotgun "1"
					ammo_buckshot "12"
				ResponseContext "weapon_mp5 weapon_glock weapon_satchel"
			}
		}
		
		create {classname "info_spawn_manager" values {targetname "syn_spawn_manager"} }
		delete {classname "info_player_start"}
		create {classname "info_player_coop" origin "-130 2885 1190" values {targetname "syn_spawnpoint_00" startdisabled "0" angles "0 0 0"} }
		create {classname "info_player_coop" origin "2400 2160 1190" values {targetname "syn_spawnpoint_01" startdisabled "1" angles "0 90 0" parentname "elev"} }
		create {classname "info_player_coop" origin "2400 2355 -1370" values {targetname "syn_spawnpoint_01a" startdisabled "1" angles "0 90 0"} }
		create {classname "info_player_coop" origin "1570 4065 -1370" values {targetname "syn_spawnpoint_02" startdisabled "1" angles "0 180 0"} }
		
		create {classname "logic_auto"
			values
			{
				spawnflags "1"
				OnMapSpawn "c1a4f_reactor_power_mathcounter,AddOutput,OnHitMax syn_endcoop:Enable::0:-1,0,-1"
				OnMapSpawn "elev_button_02,AddOutput,OnPressed syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01:0:1,0,-1"
				OnMapSpawn "elev_button_02,AddOutput,OnPressed syn_spawn_manager:SetCheckPoint:syn_spawnpoint_01a:15:1,0,-1"
				OnMapSpawn "c1a4f_reactor_power_button_g,AddOutput,OnPressed !self:kill::0:1,0,-1"
				OnMapSpawn "c1a4f_reactor_power_button_g,AddOutput,OnPressed c1a4f_reactor_power_button_d:Lock::0:1,0,-1"
				OnMapSpawn "c1a4f_reactor_power_button_d,AddOutput,OnPressed !self:kill::0:1,0,-1"
				OnMapSpawn "c1a4f_reactor_power_button_d,AddOutput,OnPressed c1a4f_reactor_power_button_g:Lock::0:1,0,-1"
				OnMapSpawn "c1a4f_reactor_stop_02,AddOutput,OnPass c1a4f_reactor_power_button_g:Unlock::0:-1,0,-1"
				OnMapSpawn "c1a4f_reactor_stop_02,AddOutput,OnPass c1a4f_reactor_power_button_d:Unlock::0:-1,0,-1"
				OnMapSpawn "c1a4f_airlock_inner_door_trigger,AddOutput,OnTrigger syn_spawn_manager:SetCheckPoint:syn_spawnpoint_02:0:1,0,-1"
			}
		}
		
		edit {targetname "c1a4f_airlock_inner_door_trigger" values {origin "1410 4064 -1328"} }
		edit {targetname "c1a4f_airlock_outer_door_trigger" values {origin "1780 4064 -1328"} }
		
		create {classname "syn_transition_wall" origin "-190 2885 1000" values {targetname "syn_wall" solid "6" angles "0 0 0" startdisabled "0"} }
		create {classname "trigger_coop" origin "-70 2880 1248"
			values
			{
				edt_getbspmodelfor_classname "trigger_once"
				edt_getbspmodelfor_origin "2656 2624 1244"
				targetname "syn_endcoop"
				startdisabled "1"
				spawnflags "1"
				usehud "1"
				playervalue "66"
				counttype "1"
				OnPlayersIn "trigger_changelevel,Enable,,0,-1"
				OnPlayersIn "syn_wall,kill,,0,-1"
				OnPlayersIn "!self,Disable,,0,-1"
			}
		}
	}
}