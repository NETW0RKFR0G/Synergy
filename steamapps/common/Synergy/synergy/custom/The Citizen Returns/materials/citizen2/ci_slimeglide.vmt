"LightmappedGeneric"
{

  "$basetexture" "citizen2/ci_slimeglide" 
  "$translucent" "1"
  "$decal" 1
  //"$envmap" "env_cubemap"
  //"$envmapmask" "citizen2/ci_slimefall_mask"	
  "$surfaceprop" "slime"	
 



"Proxies"
{
"TextureScroll"
{
"texturescrollvar" "$basetexturetransform"
"texturescrollvar" "$envmapmasktransform"
"texturescrollrate" 0.08
"texturescrollangle" -90.00
}
}
}
