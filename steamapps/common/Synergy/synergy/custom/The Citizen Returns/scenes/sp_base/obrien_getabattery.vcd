      {
        "apex" 0.275862
        "accent" 0.448276
        "loop" 0.689655
        "end" 0.862069
      }
      absolutetags shifted_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      sequenceduration 2.233333
    }
    event gesture "gest0"
    {
      time -0.033333 2.266667
      param "G_righthandpoint"
      absolutetags playback_time
      {
        "apex" 0.205882
        "accent" 0.441176
        "loop" 0.470588
        "end" 0.676471
      }
      absolutetags shifted_time
      {
        "apex" 0.205882
        "accent" 0.441176
        "loop" 0.470588
        "end" 0.676471
      }
    }
  }
  channel "faceanimations"
  {
    event flexanimation "flex1"
    {
      time 0.087719 2.000000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_tightener" combo 
        {
          0.1900 1.0000
        }
        {
          0.1900 0.5000
        }
        "outer_raiser" combo 
        {
          0.1900 1.0000
        }
        {
          0.1900 0.5000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "76"
  "RampTool" "100"
  "ExpressionTool" "100"
