// Choreo version 1
actor "rebel01"
{
  channel "wav"
  {
    event speak "npc_precasino_doingsomething"
    {
      time 0.100000 2.273991
      param "npc_precasino_doingsomething"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 0.053333 2.800000
      param "!player"
    }
  }
  channel "gesture"
  {
    event gesture "gest"
    {
      time 1.286666 2.986666
      param "G_shrug"
      absolutetags playback_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "end" 0.440000
      }
      absolutetags shifted_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "end" 0.440000
      }
      sequenceduration 1.700000
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
