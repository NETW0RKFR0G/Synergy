// Choreo version 1
actor "stranded"
{
  channel "wav"
  {
    event speak "wav"
    {
      time 0.046667 2.759660
      param "npc_casino2_beenstuck"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "lookat"
  {
    event lookat "at player"
    {
      time 1.680000 3.033333
      param "!player"
    }
    event lookat "at player 0"
    {
      time -0.100000 0.660000
      param "!player"
    }
  }
  channel "face expression"
  {
    event flexanimation "flex1"
    {
      time 0.726667 1.620000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "half_closed" 
        {
          0.1140 0.0000
        }
        "inner_raiser" combo 
        {
          0.1140 1.0000
        }
        {
          0.1140 0.5000
        }
        "cheek_raiser" combo 
        {
          0.1140 0.9600
        }
        {
          0.1140 0.5000
        }
        "head_updown" range 15.0 -15.0 
        {
          0.1140 -0.0000
        }
        "head_tilt" range 15.0 -15.0 
        {
          0.1140 0.7200
        }
        "eyes_updown" range 30.0 -30.0 
        {
          0.1140 0.0200
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
