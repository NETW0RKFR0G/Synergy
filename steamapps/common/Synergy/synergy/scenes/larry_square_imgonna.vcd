// Choreo version 1
actor "larry"
{
  channel "WAV"
  {
    event speak "wav"
    {
      time 0.133333 2.199909
      param "npc_larry_square_imgonna"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "gestures"
  {
    event gesture "gest1"
    {
      time 1.360000 3.060000
      param "G_look_small"
      absolutetags playback_time
      {
        "apex" 0.160000
        "accent" 0.240000
        "loop" 0.320000
        "end" 0.440000
      }
      absolutetags shifted_time
      {
        "apex" 0.325581
        "accent" 0.465116
        "loop" 0.604651
        "end" 0.697674
      }
      sequenceduration 1.466667
    }
  }
  channel "expressions"
  {
    event flexanimation "flex1"
    {
      time 0.093333 1.460000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "outer_raiser" combo 
        {
          0.1540 1.0000
        }
        {
          0.1540 0.5000
        }
        "head_updown" range 15.0 -15.0 
        {
          0.1540 0.0000
        }
        "eyes_updown" range 30.0 -30.0 
        {
          0.1540 0.0000
        }
      }
    }
    event flexanimation "flex2"
    {
      time 1.520000 3.053334
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.1300 1.0000
        }
        {
          0.1300 0.5000
        }
        "inner_raiser" combo 
        {
          0.1300 1.0000
        }
        {
          0.1300 0.5000
        }
        "part" combo 
        {
          0.1300 1.0000
        }
        {
          0.1300 0.5000
        }
        "puckerer" combo 
        {
          0.1300 0.2800
        }
        {
          0.1300 0.5000
        }
        "head_forwardback" range 0.2 -0.2 
        {
          0.1300 0.0000
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "ExpressionTool" "100"
  "RampTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
