// Choreo version 1
actor "rebel1example"
{
  channel "wav"
  {
    event speak "3"
    {
      time 0.153335 2.286669
      param "npc_male_ihatebugs"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "facial expressions"
  {
    event flexanimation "flex3"
    {
      time 0.053333 3.166666
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_raiser" combo 
        {
          0.1980 1.0000
        }
        {
          0.1980 0.5000
        }
        "outer_raiser" combo 
        {
          0.1980 1.0000
        }
        {
          0.1980 0.5000
        }
        "wrinkler" 
        {
          0.1980 1.0000
        }
        "corner_depressor" combo 
        {
          0.1980 0.7800
        }
        {
          0.1980 0.5000
        }
        "funneler" combo 
        {
          0.1980 0.7600
        }
        {
          0.1980 0.5000
        }
        "bite" 
        {
          0.1980 0.5200
        }
      }
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 0.786666 3.020000
      param "G_noway_big"
      absolutetags playback_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      absolutetags shifted_time
      {
        "apex" 0.151515
        "accent" 0.272727
        "loop" 0.424242
        "end" 0.575758
      }
      sequenceduration 2.233333
    }
  }
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 0.046666 3.366667
      param "!player"
    }
  }
  channel "face"
  {
    event face "faceplayer"
    {
      time 0.026667 3.326668
      param "!player"
    }
  }
}

