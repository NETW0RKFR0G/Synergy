// Choreo version 1
actor "rebel_exhelper"
{
  channel "wav"
  {
    event speak "1"
    {
      time 0.080000 4.142766
      param "npc_square_explosiveshelper"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "look"
  {
    event lookat "1"
    {
      time 0.053333 5.046667
      param "!player"
    }
  }
  channel "gesture"
  {
    event gesture "gesture1"
    {
      time 1.040000 2.673333
      param "G_righthandpoint"
      absolutetags playback_time
      {
        "apex" 0.291667
        "accent" 0.416667
        "loop" 0.520833
        "extreme" 0.541667
        "end" 0.625000
      }
      absolutetags shifted_time
      {
        "apex" 0.310345
        "accent" 0.500000
        "extreme" 0.541667
        "loop" 0.586207
        "end" 0.655172
      }
      sequenceduration 1.966667
    }
    event gesture "salute"
    {
      time 3.853333 5.079999
      param "g_salute"
    }
  }
  channel "face"
  {
    event face "face player"
    {
      time 0.033333 5.093332
      param "!player"
    }
  }
  channel "flex"
  {
    event flexanimation "flex1"
    {
      time 1.073334 3.020000
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "lid_tightener" combo 
        {
          0.2080 0.9800
        }
        {
          0.2080 0.5000
        }
        "outer_raiser" combo 
        {
          0.2080 0.8100
        }
        {
          0.2080 0.5000
        }
        "head_updown" range 15.0 -15.0 
        {
          0.2080 0.2500
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
