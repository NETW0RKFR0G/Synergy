// envmaptint_fix
"LightmappedGeneric"
{
	"$basetexture" "citizen2/ci_leavesfloor1"
	"$surfaceprop" "concrete"
	"$envmaptint" "[ .5 .5 .5 ]"

	"LightmappedGeneric_DX9"
 	{
		"$bumpmap" "citizen2/ci_leavesfloor1_normal"
