// Choreo version 1
actor "sarah"
{
  channel "wav"
  {
    event speak "npc_sarah_controlroom"
    {
      time 0.093334 2.031973
      param "npc_sarah_controlroom"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 0.033333 2.233333
      param "!player"
    }
  }
  channel "gest"
  {
    event gesture "gest"
    {
      time 0.860001 2.493334
      param "g_right_openhand"
      absolutetags playback_time
      {
        "apex" 0.291667
        "accent" 0.416667
        "loop" 0.520833
        "end" 0.625000
      }
      absolutetags shifted_time
      {
        "apex" 0.291667
        "accent" 0.416667
        "loop" 0.520833
        "end" 0.625000
      }
      sequenceduration 1.633333
    }
  }
  channel "flex"
  {
    event flexanimation "flex"
    {
      time 0.113334 2.166667
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "inner_raiser" combo 
        {
          0.1860 1.0000
        }
        {
          0.1860 0.5000
        }
        "corner_depressor" combo 
        {
          0.1860 0.4800
        }
        {
          0.1860 0.5000
        }
        "part" combo 
        {
          0.1860 1.0000
        }
        {
          0.1860 0.5000
        }
        "head_tilt" range 15.0 -15.0 
        {
          0.1860 0.0000
        }
      }
    }
  }
  channel "face"
  {
    event face "faceplayer"
    {
      time 0.026667 2.593334
      param "!player"
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
