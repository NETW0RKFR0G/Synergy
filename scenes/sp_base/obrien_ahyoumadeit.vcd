// Choreo version 1
actor "obrien"
{
  channel "wav"
  {
    event speak "obrien_ahyoumadeit"
    {
      time 0.106667 1.399592
      param "npc_obrien_ahyoumadeit"
      fixedlength
      cctype "cc_master"
      cctoken ""
    }
  }
  channel "facetowards"
  {
    event face "faceplayer"
    {
      time 0.026666 1.440000
      param "!player"
    }
  }
  channel "lookat"
  {
    event lookat "atplayer"
    {
      time 0.020000 1.446667
      param "!player"
    }
  }
  channel "gesture"
  {
    event gesture "gest1"
    {
      time 0.713334 2.513334
      param "g_fist"
      absolutetags playback_time
      {
        "apex" 0.188679
        "accent" 0.511667
        "loop" 0.521667
        "end" 0.531667
        "extreme" 0.541667
      }
      absolutetags shifted_time
      {
        "apex" 0.176471
        "accent" 0.250000
        "loop" 0.441176
        "end" 0.588235
        "extreme" 0.792453
      }
      sequenceduration 2.300000
    }
  }
  channel "faceanimations"
  {
    event flexanimation "flex1"
    {
      time 0.326667 1.786667
      param ""
      flexanimations samples_use_time defaultcurvetype=curve_catmullrom_normalize_x_to_curve_catmullrom_normalize_x
      {
        "smile" 
        {
          0.1700 0.8400
        }
      }
    }
  }
}

scalesettings
{
  "CChoreoView" "100"
  "RampTool" "100"
  "ExpressionTool" "100"
  "GestureTool" "100"
  "SceneRampTool" "100"
}
fps 60
snap off
ignorePhonemes off
